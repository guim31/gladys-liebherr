{
  "manifest_version": 1,
  "type": "device",
  "name": "Liebherr SmartDevice",
  "description": {
    "en": "Liebherr fridges, freezers and wine cabinets: temperatures, setpoints, modes, alarms.",
    "fr": "Réfrigérateurs, congélateurs et caves Liebherr : températures, consignes, modes, alarmes.",
    "de": "Liebherr-Kühl-, Gefrier- und Weingeräte: Temperaturen, Sollwerte, Modi, Alarme.",
    "es": "Frigoríficos, congeladores y vinotecas Liebherr: temperaturas, consignas, modos, alarmas."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-liebherr:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-liebherr/main/cover.png",
  "categories": ["appliances"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Liebherr account",
        "fr": "Votre compte Liebherr",
        "de": "Dein Liebherr-Konto",
        "es": "Su cuenta Liebherr"
      },
      "description": {
        "en": "The appliances must be connected in the SmartDevice app. In the app: Settings, Become a beta tester, activate the HomeAPI, Generate new key. Copy the key at once: it is shown only once.",
        "fr": "Les appareils doivent être connectés dans l'application SmartDevice. Dans l'application : Réglages, Devenir bêta-testeur, activez la HomeAPI, Générer une nouvelle clé. Copiez la clé tout de suite : elle ne s'affiche qu'une fois.",
        "de": "Die Geräte müssen in der SmartDevice-App verbunden sein. In der App: Einstellungen, Beta-Tester werden, HomeAPI aktivieren, Neuen Schlüssel erzeugen. Kopiere den Schlüssel sofort: Er wird nur einmal angezeigt.",
        "es": "Los aparatos deben estar conectados en la aplicación SmartDevice. En la aplicación: Ajustes, Ser beta tester, active la HomeAPI, Generar nueva clave. Copie la clave enseguida: solo se muestra una vez."
      },
      "links": [
        {
          "url": "https://developer.liebherr.com/apis/smartdevice-homeapi/",
          "label": {
            "en": "Liebherr HomeAPI",
            "fr": "HomeAPI de Liebherr",
            "de": "Liebherr HomeAPI",
            "es": "HomeAPI de Liebherr"
          }
        }
      ]
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "API key",
        "fr": "Clé d'API",
        "de": "API-Schlüssel",
        "es": "Clave de API"
      },
      "description": {
        "en": "The key generated in the SmartDevice app. A new key replaces the previous one.",
        "fr": "La clé générée dans l'application SmartDevice. Une nouvelle clé remplace la précédente.",
        "de": "Der in der SmartDevice-App erzeugte Schlüssel. Ein neuer Schlüssel ersetzt den vorherigen.",
        "es": "La clave generada en la aplicación SmartDevice. Una clave nueva sustituye a la anterior."
      },
      "required": true
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often the Liebherr cloud is read. Liebherr limits the number of calls: stay at 2 minutes or more with several appliances.",
        "fr": "Fréquence de lecture du cloud Liebherr. Liebherr limite le nombre d'appels : restez à 2 minutes ou plus avec plusieurs appareils.",
        "de": "Wie oft die Liebherr-Cloud gelesen wird. Liebherr begrenzt die Anzahl der Aufrufe: Bleib bei mehreren Geräten bei 2 Minuten oder mehr.",
        "es": "Frecuencia de lectura de la nube de Liebherr. Liebherr limita el número de llamadas: mantenga 2 minutos o más con varios aparatos."
      },
      "required": false,
      "default": "120",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "180",
          "label": {
            "en": "3 minutes",
            "fr": "3 minutes",
            "de": "3 Minuten",
            "es": "3 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        }
      ]
    },
    {
      "key": "alarms",
      "type": "section",
      "label": {
        "en": "Alarms",
        "fr": "Alarmes",
        "de": "Alarme",
        "es": "Alarmas"
      },
      "description": {
        "en": "The Liebherr cloud reports no alarm: the integration works them out from the readings and fires the \"Liebherr alarm\" scene triggers.",
        "fr": "Le cloud Liebherr ne signale aucune alarme : l'intégration les déduit des relevés et déclenche les scènes « Alarme Liebherr ».",
        "de": "Die Liebherr-Cloud meldet keine Alarme: Die Integration leitet sie aus den Messwerten ab und löst die Szenen-Auslöser „Liebherr-Alarm“ aus.",
        "es": "La nube de Liebherr no informa de alarmas: la integración las deduce de las lecturas y activa los disparadores «Alarma Liebherr»."
      }
    },
    {
      "key": "alarm_margin",
      "type": "select",
      "label": {
        "en": "Temperature alarm margin",
        "fr": "Marge de l'alarme de température",
        "de": "Toleranz des Temperaturalarms",
        "es": "Margen de la alarma de temperatura"
      },
      "description": {
        "en": "Alarm when a zone stays this far above its setpoint.",
        "fr": "Alarme quand une zone reste à cet écart au-dessus de sa consigne.",
        "de": "Alarm, wenn ein Bereich so weit über seinem Sollwert bleibt.",
        "es": "Alarma cuando una zona se mantiene así de por encima de su consigna."
      },
      "required": false,
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": {
            "en": "2 °C",
            "fr": "2 °C",
            "de": "2 °C",
            "es": "2 °C"
          }
        },
        {
          "value": "3",
          "label": {
            "en": "3 °C",
            "fr": "3 °C",
            "de": "3 °C",
            "es": "3 °C"
          }
        },
        {
          "value": "5",
          "label": {
            "en": "5 °C",
            "fr": "5 °C",
            "de": "5 °C",
            "es": "5 °C"
          }
        },
        {
          "value": "8",
          "label": {
            "en": "8 °C",
            "fr": "8 °C",
            "de": "8 °C",
            "es": "8 °C"
          }
        }
      ]
    },
    {
      "key": "alarm_delay",
      "type": "select",
      "label": {
        "en": "Alarm delay",
        "fr": "Délai d'alarme",
        "de": "Alarmverzögerung",
        "es": "Retardo de la alarma"
      },
      "description": {
        "en": "How long the temperature (or the appliance offline) must last before the alarm.",
        "fr": "Durée pendant laquelle la température (ou l'appareil hors ligne) doit durer avant l'alarme.",
        "de": "Wie lange die Temperatur (oder das Gerät offline) anhalten muss, bevor der Alarm kommt.",
        "es": "Cuánto tiempo debe durar la temperatura (o el aparato sin conexión) antes de la alarma."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 minutes",
            "fr": "30 minutes",
            "de": "30 Minuten",
            "es": "30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "60 minutes",
            "fr": "60 minutes",
            "de": "60 Minuten",
            "es": "60 minutos"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "120 minutes",
            "fr": "120 minutes",
            "de": "120 Minuten",
            "es": "120 minutos"
          }
        }
      ]
    },
    {
      "key": "door_alarm_delay",
      "type": "select",
      "label": {
        "en": "Door alarm delay (AutoDoor)",
        "fr": "Délai de l'alarme de porte (AutoDoor)",
        "de": "Verzögerung des Türalarms (AutoDoor)",
        "es": "Retardo de la alarma de puerta (AutoDoor)"
      },
      "description": {
        "en": "Only the AutoDoor models report their door.",
        "fr": "Seuls les modèles AutoDoor signalent leur porte.",
        "de": "Nur die AutoDoor-Modelle melden ihre Tür.",
        "es": "Solo los modelos AutoDoor informan de su puerta."
      },
      "required": false,
      "default": "5",
      "options": [
        {
          "value": "2",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "5",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Names given to the features when the devices are created in Gladys.",
        "fr": "Noms donnés aux fonctionnalités à la création des appareils dans Gladys.",
        "de": "Namen der Funktionen beim Anlegen der Geräte in Gladys.",
        "es": "Nombres dados a las funciones al crear los dispositivos en Gladys."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads the appliances of the account now and shows their temperatures.",
        "fr": "Lit maintenant les appareils du compte et affiche leurs températures.",
        "de": "Liest jetzt die Geräte des Kontos und zeigt ihre Temperaturen.",
        "es": "Lee ahora los aparatos de la cuenta y muestra sus temperaturas."
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "alarm_raised",
      "label": {
        "en": "Liebherr alarm",
        "fr": "Alarme Liebherr",
        "de": "Liebherr-Alarm",
        "es": "Alarma Liebherr"
      },
      "description": {
        "en": "A zone too warm, an AutoDoor open or an appliance offline, for the configured delay.",
        "fr": "Une zone trop chaude, une AutoDoor ouverte ou un appareil hors ligne, pendant le délai réglé.",
        "de": "Ein zu warmer Bereich, eine offene AutoDoor oder ein Gerät offline, für die eingestellte Dauer.",
        "es": "Una zona demasiado caliente, una AutoDoor abierta o un aparato sin conexión, durante el retardo elegido."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Appliance",
            "fr": "Appareil",
            "de": "Gerät",
            "es": "Aparato"
          }
        },
        {
          "key": "kind",
          "type": "multi_select",
          "label": {
            "en": "Alarm",
            "fr": "Alarme",
            "de": "Alarm",
            "es": "Alarma"
          },
          "description": {
            "en": "Leave empty for every alarm.",
            "fr": "Laissez vide pour toutes les alarmes.",
            "de": "Leer lassen für alle Alarme.",
            "es": "Déjelo vacío para todas las alarmas."
          },
          "options": [
            {
              "value": "temperature",
              "label": {
                "en": "Temperature too high",
                "fr": "Température trop haute",
                "de": "Temperatur zu hoch",
                "es": "Temperatura demasiado alta"
              }
            },
            {
              "value": "door",
              "label": {
                "en": "Door open too long (AutoDoor)",
                "fr": "Porte ouverte trop longtemps (AutoDoor)",
                "de": "Tür zu lange offen (AutoDoor)",
                "es": "Puerta abierta demasiado tiempo (AutoDoor)"
              }
            },
            {
              "value": "offline",
              "label": {
                "en": "Appliance offline",
                "fr": "Appareil hors ligne",
                "de": "Gerät offline",
                "es": "Aparato sin conexión"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "kind",
          "type": "string",
          "label": {
            "en": "Alarm (temperature, door, offline)",
            "fr": "Alarme (temperature, door, offline)",
            "de": "Alarm (temperature, door, offline)",
            "es": "Alarma (temperature, door, offline)"
          }
        },
        {
          "key": "appliance",
          "type": "string",
          "label": {
            "en": "Appliance",
            "fr": "Appareil",
            "de": "Gerät",
            "es": "Aparato"
          }
        },
        {
          "key": "zone",
          "type": "string",
          "label": {
            "en": "Zone",
            "fr": "Zone",
            "de": "Bereich",
            "es": "Zona"
          }
        },
        {
          "key": "temperature",
          "type": "number",
          "label": {
            "en": "Temperature",
            "fr": "Température",
            "de": "Temperatur",
            "es": "Temperatura"
          }
        },
        {
          "key": "target",
          "type": "number",
          "label": {
            "en": "Setpoint",
            "fr": "Consigne",
            "de": "Solltemperatur",
            "es": "Consigna"
          }
        },
        {
          "key": "unit",
          "type": "string",
          "label": {
            "en": "Unit",
            "fr": "Unité",
            "de": "Einheit",
            "es": "Unidad"
          }
        },
        {
          "key": "minutes",
          "type": "number",
          "label": {
            "en": "Minutes since the problem began",
            "fr": "Minutes depuis le début du problème",
            "de": "Minuten seit Beginn des Problems",
            "es": "Minutos desde el inicio del problema"
          }
        }
      ]
    },
