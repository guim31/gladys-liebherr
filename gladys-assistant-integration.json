  "widgets": [
    {
      "key": "liebherr",
      "label": {
        "en": "Liebherr",
        "fr": "Liebherr",
        "de": "Liebherr",
        "es": "Liebherr"
      },
      "description": {
        "en": "Zone temperatures, alarms, and the SuperCool, SuperFrost and PartyMode buttons.",
        "fr": "Températures des zones, alarmes, et les boutons SuperCool, SuperFrost et PartyMode.",
        "de": "Temperaturen der Bereiche, Alarme und die Tasten SuperCool, SuperFrost und PartyMode.",
